# Copy to .env next to docker-compose.yml on the server. Never committed:
# .gitignore holds .env and .env.* for this reason.
#
#   cp deploy/.env.example .env && $EDITOR .env

# Zero Trust ▸ Networks ▸ Tunnels ▸ (your tunnel) ▸ Install connector.
# One token per tunnel; it is the tunnel's credential, so treat it the
# way you treat a password.
CLOUDFLARE_TUNNEL_TOKEN=

# The model is called over the API - nothing here is trained.
OPENAI_API_KEY=

# Optional ceiling, in dollars, on what a single run may spend. Left
# empty, pipeline/llm/client.py uses its own default.
ICP_LLM_BUDGET_USD=
