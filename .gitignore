# --- Not public ---------------------------------------------------------
# The engine is public, RTsoft's material is not. docs/ holds the task and
# their ICP; web/icp.json is the same profile as written by the interface.
docs/
web/icp.json*

# --- Project data -------------------------------------------------------
# Bulk registry snapshots and the evidence archive: over 780 MB, and every
# byte of it is re-downloadable or re-derivable. Never committed.
data/

# --- Run output ---------------------------------------------------------
# What a run prints belongs in the terminal, not in the tree. A captured
# run goes stale silently: a committed one still said "3299 companies"
# long after the pool became 9793, and a stale number in the repo is worse
# than no number, because it reads as measured.
/run_stdout.txt
/run_stderr.txt
*.log

# Probe output is deliberately NOT ignored. *_probe_out.txt files are the
# evidence the numbers in docs/reseni-log.md were read off - see 845b7f9.

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Environment and secrets --------------------------------------------
# The API key is passed with -e at run time (see the Dockerfile header) and
# the deploy secrets live on the box. Only the .env.example templates are
# tracked, so they are pulled back out.
.env
.env.*
!**/.env.example

.venv/
venv/
env/
ENV/
.python-version

# --- Editors and OS -----------------------------------------------------
.vscode/
.idea/
*.swp
tempCodeRunnerFile.py

.DS_Store
Thumbs.db
desktop.ini
